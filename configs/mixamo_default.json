def load_rig_calibration(path: str | Path | None = None) -> dict[str, Any]:
    if path is None:
        return DEFAULT_MIXAMO_CALIBRATION.copy()

    path = Path(path)
    if not path.exists():
        raise FileNotFoundError(f"Calibration file not found: {path}")

    with path.open("r", encoding="utf-8") as handle:
        data = json.load(handle)

    if not isinstance(data, dict):
        raise ValueError("Calibration file must contain a JSON object.")
    return data


def apply_rig_calibration(rotations: dict[str, Any], calibration: dict[str, Any] | None = None) -> dict[str, Any]:
    """Return rotations normalized to the configured Mixamo coordinate system.

    This is a placeholder that wires the schema and calibration contract into the
    animation export pipeline before we add full GLB parsing and rig metadata
    extraction.
    """
    selected = calibration or DEFAULT_MIXAMO_CALIBRATION
    if not isinstance(selected, dict):
        raise ValueError("Calibration must be a dictionary.")
    if "bones" not in selected:
        raise ValueError("Calibration must contain a 'bones' mapping.")

    result = {}
    for bone_name, rotation in rotations.items():
        result[bone_name] = rotation
    return result
